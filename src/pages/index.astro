---
import { getCollection } from 'astro:content';
import { isPublishable } from '../lib/publication.mjs';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const interviews = (await getCollection('interviews', isPublishable)).sort(
  (a, b) => b.data.issue - a.data.issue
);
---

<Base>
  {interviews.length === 0 && <p>公開済みの記事はまだありません。</p>}
  <ul class="index-list">
    {
      interviews.map((entry) => (
        <li>
          <span class="num">#{String(entry.data.issue).padStart(3, '0')}</span>
          <a href={`${base}/interviews/${entry.id}/`}>{entry.data.title}</a>
          {entry.data.status !== 'published' && <span class="badge-draft">準備中</span>}
          <div class="article-meta">
            {entry.data.interviewees.map((p) => p.name).join('、')}
            {entry.data.summary && <> — {entry.data.summary}</>}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
