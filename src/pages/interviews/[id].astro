---
import { getCollection, render } from 'astro:content';
import { isPublishable } from '../../lib/publication.mjs';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const interviews = await getCollection('interviews', isPublishable);
  return interviews.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateFmt = (date: Date) =>
  `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
---

<Base article title={d.title} description={d.summary || `${d.interviewees.map(p => p.name).join('・')}へのインタビュー「${d.title}」。技術と表現の現場を記録するReview of Creative Practice and Technology。`}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, inLanguage: 'ja',
    url: new URL(Astro.url.pathname, Astro.site!).href,
    datePublished: d.published.toISOString(),
    ...(d.summary ? { description: d.summary } : {}),
    ...(d.interviewers.length ? { author: d.interviewers.map(name => ({ '@type': 'Person', name })) } : {}),
    about: d.interviewees.map(p => ({ '@type': 'Person', name: p.name })),
    publisher: { '@type': 'Organization', name: 'Entangled Press' },
  }).replace(/</g, '\\u003c')} />
  <p class="issue-number">#{String(d.issue).padStart(3, '0')}</p>
  <h1 class="article-title">{d.title}</h1>
  <div class="article-meta">
    <p>
      話し手: {d.interviewees.map((p) => `${p.name}${p.affiliation ? `（${p.affiliation}）` : ''}`).join('、')}
      {d.interviewers.length > 0 && <>／聞き手: {d.interviewers.join('、')}</>}
    </p>
    <p>
      収録: {dateFmt(d.recorded)}
      {d.published && <>／公開: {dateFmt(d.published)}</>}
    </p>
  </div>
  <article class="body">
    <Content />
  </article>
</Base>
