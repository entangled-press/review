<canvas class="scroll-noise" aria-hidden="true"></canvas>

<style>
  .scroll-noise {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .scroll-noise { display: none; } }
  @media print { .scroll-noise { display: none; } }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.scroll-noise');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function setupNoise(canvas: HTMLCanvasElement) {
    // Opaque, low-resolution drawing keeps the compositing and GPU cost bounded.
    const gl = canvas.getContext('webgl', {
      alpha: false, antialias: false, depth: false, stencil: false,
      powerPreference: 'low-power',
    });
    if (!gl) return;

    const vertex = `
      attribute vec2 a_position;
      void main() { gl_Position = vec4(a_position, 0.0, 1.0); }
    `;
    const fragment = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
        precision highp float;
      #else
        precision mediump float;
      #endif
      uniform vec2 u_resolution;
      uniform float u_phase;
      uniform float u_energy;

      float hash(vec3 p) {
        p = fract(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
      }
      float noise(vec3 p) {
        vec3 cell = floor(p);
        vec3 f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        float lower = mix(mix(hash(cell), hash(cell + vec3(1,0,0)), f.x),
                          mix(hash(cell + vec3(0,1,0)), hash(cell + vec3(1,1,0)), f.x), f.y);
        float upper = mix(mix(hash(cell + vec3(0,0,1)), hash(cell + vec3(1,0,1)), f.x),
                          mix(hash(cell + vec3(0,1,1)), hash(cell + vec3(1,1,1)), f.x), f.y);
        return mix(lower, upper, f.z);
      }
      void main() {
        vec2 uv = (gl_FragCoord.xy - u_resolution * 0.5) / u_resolution.y;
        vec3 ray = normalize(vec3(uv, -1.65));
        vec3 eye = vec3(0.35, -0.15, 3.8);
        float angle = u_phase * 0.13;
        mat2 turn = mat2(cos(angle), -sin(angle), sin(angle), cos(angle));
        float grain = hash(vec3(floor(gl_FragCoord.xy), floor(u_phase * 18.0)));
        float transmission = 1.0;
        float mist = 0.0;
        // A small, fixed number of depth samples creates a volume, not a flat overlay.
        for (int i = 0; i < 8; i++) {
          float distance = 1.8 + (float(i) + grain * 0.5) * 0.58;
          vec3 p = eye + ray * distance;
          p.xz = turn * p.xz;
          p.x += sin(p.y * 1.1 + u_phase * 0.12) * 0.65;
          p.y += sin(p.z * 0.9 - u_phase * 0.09) * 0.4;
          vec3 flow = p * 1.18 + vec3(0.0, u_phase * 0.08, -u_phase * 0.06);
          float field = noise(flow) * 0.68 + noise(flow * 2.15 + 5.7) * 0.32;
          float envelope = exp(-dot(p * vec3(0.39, 0.32, 0.34), p * vec3(0.39, 0.32, 0.34)));
          float density = smoothstep(0.43, 0.73, field) * envelope * 0.34;
          float light = 0.65 + 0.35 * clamp(p.y * 0.18 + 0.5, 0.0, 1.0);
          mist += transmission * density * light;
          transmission *= 1.0 - density;
        }
        vec3 paper = vec3(10.0, 12.0, 15.0) / 255.0;
        float texture = mist * 0.13;
        texture += (grain - 0.5) * (0.012 + mist * 0.075) * (1.0 + u_energy * 0.25);
        gl_FragColor = vec4(max(paper + texture, vec3(0.0)), 1.0);
      }
    `;

    function compile(type: number, source: string) {
      const shader = gl!.createShader(type);
      if (!shader) return null;
      gl!.shaderSource(shader, source);
      gl!.compileShader(shader);
      if (!gl!.getShaderParameter(shader, gl!.COMPILE_STATUS)) {
        gl!.deleteShader(shader);
        return null;
      }
      return shader;
    }
    const vs = compile(gl.VERTEX_SHADER, vertex);
    const fs = compile(gl.FRAGMENT_SHADER, fragment);
    if (!vs || !fs) { canvas.hidden = true; return; }
    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    gl.deleteShader(vs);
    gl.deleteShader(fs);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) { canvas.hidden = true; return; }
    gl.useProgram(program);
    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, 'a_position');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
    const resolution = gl.getUniformLocation(program, 'u_resolution');
    const phaseUniform = gl.getUniformLocation(program, 'u_phase');
    const energyUniform = gl.getUniformLocation(program, 'u_energy');
    let energy = 0;
    let phase = 0;
    let frame = 0;
    let previousTime = 0;
    let previousY = window.scrollY;
    let lost = false;
    canvas.dataset.noiseState = 'still';

    function draw() {
      if (lost) return;
      gl!.uniform2f(resolution, canvas.width, canvas.height);
      gl!.uniform1f(phaseUniform, phase);
      gl!.uniform1f(energyUniform, energy);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }
    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = 0;
      energy = 0;
      canvas.dataset.noiseState = 'still';
    }
    function animate(now: number) {
      frame = 0;
      if (document.hidden || reduced.matches || lost) { stop(); return; }
      const elapsed = Math.min((now - previousTime) / 1000, 0.08);
      // At most 30 draws/second; time-based damping also works on 120Hz screens.
      if (now - previousTime >= 1000 / 30) {
        energy *= Math.exp(-elapsed / 0.42);
        phase += elapsed * energy * 3.0;
        previousTime = now;
        if (energy < 0.003) energy = 0;
        draw();
      }
      if (energy > 0) frame = requestAnimationFrame(animate);
      else canvas.dataset.noiseState = 'still';
    }
    function onScroll() {
      const delta = Math.abs(window.scrollY - previousY);
      previousY = window.scrollY;
      if (reduced.matches || document.hidden || lost || delta === 0) return;
      energy = Math.min(1, energy + Math.min(delta, 160) / 180);
      if (!frame) {
        canvas.dataset.noiseState = 'moving';
        previousTime = performance.now();
        frame = requestAnimationFrame(animate);
      }
    }
    function resize() {
      if (reduced.matches || document.hidden || lost) return;
      const scale = Math.min(window.devicePixelRatio || 1, 0.75, 1100 / window.innerWidth);
      canvas.width = Math.max(1, Math.round(window.innerWidth * scale));
      canvas.height = Math.max(1, Math.round(window.innerHeight * scale));
      gl!.viewport(0, 0, canvas.width, canvas.height);
      draw();
    }
    function onPreference() {
      stop();
      canvas.hidden = reduced.matches;
      if (!reduced.matches) resize();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', resize, { passive: true });
    reduced.addEventListener('change', onPreference);
    document.addEventListener('visibilitychange', () => {
      stop();
      previousY = window.scrollY;
      if (!document.hidden && !reduced.matches) draw();
    });
    canvas.addEventListener('webglcontextlost', () => {
      lost = true;
      stop();
      canvas.hidden = true;
    });
    window.addEventListener('pagehide', stop);
    resize();
  }

  // No context or background work at all when reduced motion is requested.
  if (canvas) {
    if (!reduced.matches) setupNoise(canvas);
    else reduced.addEventListener('change', () => {
      if (!reduced.matches) setupNoise(canvas);
    }, { once: true });
  }
</script>
